  "fetched_at": "2026-11-11",
  "formula": "运费(¥) = base_price_cny + price_per_gram_cny × 包裹重量(g)；_home 后缀 = 送上门价（默认到取货点）",
  "class_probe": {
   "small": "probe: 采购价200元/500g",
   "premium_small": "probe: 采购价6000元/2000g",
   "extra_small": "probe: 采购价25元/500g（表单首测）"
  },
